-- proxy_model.prima
-- Isolated proxy model: tests the movie-sequence judgments
-- using stand-in data. Nothing here is real production input;
-- every value is a proxy, run in isolation.

-- == the model: judgments defined once ==

fav_movie as string not_as digit;
single_in as alpha not_as empty;
batch_in as string not_as single_in;

-- == the toolbox ==

space seq {
    fn[0] = split,
    fn[1] = concat,
};

-- == the pipeline ==

pipe get_movie(batch, delim, n, sep) {
    batch as batch_in;
    n as int;
    -> fn[0] from seq(batch, delim, n);
    result as fav_movie;
    -> fn[1] from seq(result, sep);
    -> fn[1] from seq(result, n);
    output result;
};

-- == proxy test batch A: valid sequence ==

get_movie("Crouching Tiger,Hidden Dragon,Kung Fu Hustle", ",", 0, ": ");
get_movie("Crouching Tiger,Hidden Dragon,Kung Fu Hustle", ",", 1, ": ");
get_movie("Crouching Tiger,Hidden Dragon,Kung Fu Hustle", ",", 2, ": ");

-- == proxy test batch B: sequence with an edge element ==

get_movie("Spirited Away,Big Hero 6", ",", 1, ": ");
