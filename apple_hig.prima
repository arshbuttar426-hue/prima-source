frame AppleHIG {
  version: "1.0"
  description: "Apple Human Interface Guidelines — compiled design DNA"
  source: "apple.com + HIG specification"
}

frame Colors {
  background: white(#ffffff)
  background_light: light_gray(#f5f5f7)
  background_dark: almost_black(#1d1d1f)
  nav_glass: frosted(rgba(255,255,255,0.72), blur(20px), saturate(180%))
  text_primary: almost_black(#1d1d1f)
  text_secondary: gray(#86868b)
  text_tertiary: gray_light(#6e6e73)
  link: blue(#0066cc)
  footer_bg: light_gray(#f5f5f7)
  footer_text: rgba(0,0,0,0.56)
  border: rgba(0,0,0,0.08)
  shadow_card: rgba(0,0,0,0.04)
  dark_bg: almost_black(#1d1d1f)
  dark_surface: near_black(#161617)
  red: apple_red(#FF3B30)
  orange: apple_orange(#FF9500)
  yellow: apple_yellow(#FFCC00)
  green: apple_green(#34C759)
  teal: apple_teal(#5AC8FA)
  blue: apple_blue(#007AFF)
  purple: apple_purple(#AF52DE)
  pink: apple_pink(#FF2D55)
}

frame Typography {
  font_family: "Inter" fallback("-apple-system", "BlinkMacSystemFont", "sans-serif")
  hero_headline: weight(600) size(56px) letter(-0.025em) line(1.05)
  hero_subhead: weight(400) size(21px) letter(0) line(1.3)
  section_title: weight(600) size(40px) letter(-0.02em) line(1.1)
  card_title: weight(600) size(21px) letter(-0.01em) line(1.2)
  body: weight(400) size(17px) letter(0) line(1.5)
  caption: weight(400) size(14px) letter(0) line(1.4)
  nav_item: weight(400) size(12px) letter(-0.01em) line(1)
  cta_link: weight(400) size(17px) letter(0) line(1)
  footer_heading: weight(600) size(12px) letter(0) line(1)
  footer_link: weight(400) size(12px) letter(0) line(1)
  copyright: weight(400) size(12px) letter(0) line(1.4)
}

frame Spacing {
  unit: 8px
  nav_height: 44px
  hero_padding_top: 80px
  hero_padding_bottom: 0
  section_padding: 100px 48px
  card_gap: 12px
  card_padding: 48px
  content_max_width: 980px
  cta_gap: 24px
  footer_padding: 60px 48px 30px
  footer_column_gap: 24px
}

frame Layout {
  nav: horizontal(center, sticky, top)
  nav_items: evenly_spaced
  hero: vertical(center, text_center)
  product_grid: 2_column(equal, gap:12px)
  strip: horizontal(scroll, snap, gap:24px)
  footer: grid(columns:5, gap:24px)
}

frame Motion {
  scroll_reveal: fade_up(0.6s) on enter
  card_hover: scale(1.01) ease(0.3s)
  nav_scroll: bg_opaque on scroll_past(10px)
  image_load: fade_in(0.4s)
  page_transition: crossfade(0.25s)
}

frame Components {
  cta_pair: [primary_link, secondary_link] gap(24px)
  cta_primary: color(blue) underline_slide on hover
  cta_secondary: color(blue) underline_slide on hover
  card: bg(light_gray) radius(0) border(none)
  product_hero: full_bleed_image with centered_text
  strip_card: bg(light_gray) radius(16px) padding(24px)
  nav_bar: glass_blur height(44px) sticky
}
