-- test.prima
-- validated score processor: exercise all three primitives

-- frame definitions
name as alpha not_as number;
score as number not_as negative;

-- function spaces: unary (single-arg) and binary (two-arg)
space unary {
    fn[0] = double,
    fn[1] = abs,
    fn[2] = negate
};

space binary {
    fn[0] = add,
    fn[1] = sub,
    fn[2] = mul
};

-- pipeline: validate + apply unary curve + validate output
pipe curve(student, raw, method) {
    student as name;
    raw as score;
    -> fn[method] from unary(raw);
    result as number;
    result not_as negative;
    output result;
};

-- pipeline: combine two scores (explicit args)
pipe combine(a, b, method) {
    a as number;
    b as number;
    -> fn[method] from binary(a, b);
    result as number;
    output result;
};

-- exec: unary curve
curve("Alice", 70, 0);
curve("Bob", 5, 1);
curve("Charlie", 0, 2);

-- exec: binary combine
combine(10, 20, 0);
combine(50, 15, 1);
combine(6, 7, 2);
