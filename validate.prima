-- validate.prima — constraint-based CSV validator
-- Reads data/records.csv, validates each field against constraints, reports violations

space io { fn[0] = read_file, };
space str { fn[0] = split_list, fn[1] = trim, fn[2] = length, };
space rx { fn[0] = regex_match, };

-- Column-specific validators
valid_name as string not_as empty;
valid_email as string not_as empty;
valid_age as int not_as negative;
valid_amount as number not_as negative;
valid_category as string not_as empty;

-- Pipeline: validate one column of one row
pipe check_str(val, col) {
    val as string;
    output val;
};

-- Main pipeline: validate entire CSV
pipe validate(path) {
    -> fn[0] from io(path);
    result as string;
    output result;
};

validate("data/records.csv");
