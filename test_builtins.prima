-- test_builtins.prima: exercise new frames and functions

space arith {
    fn[0] = sqrt,
    fn[1] = floor,
    fn[2] = ceil,
    fn[3] = round,
    fn[4] = mod,
    fn[5] = pow,
};

space strings {
    fn[0] = title,
    fn[1] = replace,
    fn[2] = substr,
    fn[3] = split,
    fn[4] = type,
};

-- sqrt, floor, ceil, round
pipe do_arith(x, op) {
    -> fn[op] from arith(x);
    output result;
};

-- string operations
pipe do_string(s, op) {
    s as string;
    -> fn[op] from strings(s);
    output result;
};

-- mod needs two args
pipe do_mod(a, b) {
    -> fn[4] from arith(a, b);
    output result;
};

-- pow needs two args
pipe do_pow(a, b) {
    -> fn[5] from arith(a, b);
    output result;
};

-- replace needs three args
pipe do_replace(hay, needle, repl) {
    -> fn[1] from strings(hay, needle, repl);
    output result;
};

-- substr needs two or three
pipe do_substr(s, start, len) {
    -> fn[2] from strings(s, start, len);
    output result;
};

-- split
pipe do_split(s, delim, idx) {
    -> fn[3] from strings(s, delim, idx);
    output result;
};

do_arith(16, 0);
do_arith(9, 0);
do_arith(37, 1);
do_arith(32, 2);
do_arith(35, 3);
do_mod(10, 3);
do_pow(2, 10);
do_string("hello world", 0);
do_replace("one two one", "one", "three");
do_substr("abcdef", 2, 3);
do_split("a,b,c", ",", 1);
